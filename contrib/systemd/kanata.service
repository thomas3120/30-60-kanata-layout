# Example systemd user unit for kanata.
# Copy this file to ~/.config/systemd/user/kanata.service and adjust ExecStart
# if your kanata binary or configuration is somewhere else.

[Unit]
Description=Kanata keyboard remapper
Documentation=https://github.com/jtroo/kanata

[Service]
Type=simple
ExecStart=%h/.config/kanata/kanata_linux_x64 --cfg %h/.config/kanata/kanata.kbd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
